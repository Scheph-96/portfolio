<div class="work-body">
    <% if(experienceFavorite) { %>
        <div class="work-item">
          <ul>
            <% for(let i = 0; i < experienceFavorite.ressources.length; i++) { %>
            <li>
              <figure class="work-figure">
                  <img src="<%= experienceFavorite.ressources[i].cover %>" alt="<%= experienceFavorite.ressources[i].tagInfo %>">
                <!-- </a> -->
                <div class="work-figure-content">
                  <h4><%= experienceFavorite.ressources[i].tagInfo %></h4>
                  <p><%= experienceFavorite.ressources[i].description %></p>
                  <div class="languages">
                    <% for(let j = 0; j< experienceFavorite.ressources[i].tags.length; j++) { %>
                    <span><%= experienceFavorite.ressources[i].tags[j] %></span>
                    <% } %>
                  </div>
                  <button class="default-btn">
                    <a href="<%= experienceFavorite.ressources[i].link %>" target="_blank">
                      Explore <i class='bx bx-link-external'></i>
                    </a>
                  </button>
                </div>
              </figure>
            </li>
            <% } %>
            <li class="more-work" more="<%= experienceFavorite.type %>">
              <figure>
                <p>SEE MORE</p>
              </figure>
            </li>
          </ul>
        </div>
    <% } %>
</div>