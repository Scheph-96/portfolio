<div class="work-body">
    <% if(experienceFavorite) { %>
        <div class="work-item">
          <ul>
            <% for(let i = 0; i < experienceFavorite.ressources.length; i++) { %>
            <li>
              <figure class="work-figure">
                <!-- <a href="<%= //experienceFavorite.ressources[i].link %>" target="_blank"> -->
                  <img src="<%= experienceFavorite.ressources[i].cover %>" alt="<%= experienceFavorite.ressources[i].tagInfo %>">
                <!-- </a> -->
                <div class="work-figure-content">
                  <h4>Gestion de clinique</h4>
                  <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit. Quod repellendus veritatis maiores amet reprehenderit porro consequuntur minima ipsa illo beatae.</p>
                  <div class="languages">
                    <span>html</span>
                    <span>css</span>
                    <span>javascript</span>
                  </div>
                  <button class="default-btn">Explore <i class='bx bx-link-external'></i></button>
                </div>
              </figure>
            </li>
            <% } %>
            <li class="more-work" more="<%= experienceFavorite.type %>">
              <figure>
                <p>SEE MORE</p>
              </figure>
            </li>
          </ul>
        </div>
    <% } %>
</div>