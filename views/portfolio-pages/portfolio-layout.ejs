                    <span class="arc arc-end"></span>
                    <p>70%</p>
                    <p>vuejs</p>
                  </div>
                </div>
                <div class="visible-language">
                  <div class="svelte circle-progress">
                    <span class="arc arc-start"></span>
                    <span class="arc arc-end"></span>
                    <p>70%</p>
                    <p>svelte</p>
                  </div>
                  <div class="laravel circle-progress">
