            </div>
            <span class="divider"></span>
            <div class="spoken-languages">
              <h6>Languages</h6>
              <div class="">
                <div class="spoken-language">
                  <p class="title">ENGLISH</p>
                  <span class="english"></span>
                </div>
                <div class="spoken-language">
                  <p class="title">FRENCH</p>
                  <span class="french"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="main-content">
        <div class="top-bg"></div>
        <div class="container">
          <% if (skeleton) { %>
          <%- include(skeleton) %>
          <% } %>
        </div>
        <div class="collapse-expand-sidebar">
          <i class='bx bx-chevron-left'></i>
        </div>
      </section>
    </div>
  </main>

  <!-- Swiper JS -->
  <script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
  <script src="/js/portfolio-js/main.js" type="module"></script>




