<div class="header">
  <div class="greeting-text">
    <h2>Looking for a services?</h2>
    <h3>Hello,</h3>
    <p>
      I’m a web developer with experience in HTML, CSS, JavaScript, REACT, and Node.js. I enjoy creating websites and web applications that are fast, responsive, and easy to use. I’m always learning and improving, and I love turning ideas into functional products.
      Feel free to explore my page &#128522;
    </p>
  </div>
</div>
<div class="body">
  <div class="status">
    <div class="experience-year">
      <span>5+</span>
      <p>Years Experience</p>
    </div>
    <div class="completed-projects">
      <span>35</span>
      <p>Completed Projects</p>
    </div>
    <div class="happy-customers">
      <span>15</span>
      <p>Happy Customers</p>
    </div>
  </div>
  <div class="works">
    <div class="works-header section-header">
      <h2>Projects</h2>
      <div class="work-filter">
        <ul>
          <li class="title active" type="html_css">html-css</li>
          <li class="title" type="react">react</li>
          <li class="title" type="nodejs">node.js</li>
          <!-- <li class="title" type="logo">logo</li> -->
        </ul>
      </div>
      <div class="work-filter-shortcut">
        <i class='bx bx-dots-vertical-rounded'></i>
      </div>
    </div>
    <div class="works-content">
      <%- include('works-body') %>
    </div>
  </div>
  <div class="contact dark">
    <h2>Contact me</h2>
    <form method="post" id="contact-form" enctype="multipart/form-data">
      <div class="form-container">
        <div class="input-box">
          <input type="text" name="name" id="customer-name" placeholder="Name" required>
          <label class="input-icon-box" for="customer-name"><i class='bx bxs-user'></i></label>
        </div>
        <div class="input-box">
          <input type="email" name="email" id="customer-email" placeholder="Email" required>
          <label class="input-icon-box" for="customer-email"><i class='bx bx-at'></i></label>
        </div>
        <div class="input-box">
          <input type="text" name="subject" id="customer-email-subject" placeholder="Subject" required>
          <label class="input-icon-box" for="customer-email-subject"><i class='bx bx-question-mark'></i></label>
        </div>
        <div class="input-box">
          <textarea name="message" id="customer-message" cols="30" rows="13" placeholder="Message"></textarea>
          <label class="input-icon-box" for="customer-message"><i class='bx bxs-envelope'></i></label>
        </div>
        <div class="submit-box">
          <input type="submit" id="submit-button" value="send message">
        </div>
      </div>
    </form>
  </div>
</div>
<div class="footer">
  <footer>
    <div class="copyright">
      <p>Copyright &COPY; All right reserved <%= new Date().getFullYear() %></p>
    </div>
    <div class="author">
      <p>Author: <a href="#">Omar Scheph</a></p>
    </div>
  </footer>
</div>