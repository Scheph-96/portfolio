<div class="header">
  <div class="greeting-text">
    <h2>Looking for a services?</h2>
    <h3>Hello,</h3>
    <p>
      I’m a web developer with experience in HTML, CSS, JavaScript, REACT, and Node.js. I enjoy creating websites and web applications that are fast, responsive, and easy to use. I’m always learning and improving, and I love turning ideas into functional products.
      Feel free to explore my page &#128522;
    </p>
  </div>
  <div class="coder">
    <img src="/assets/portfolio/img/coder.png">
  </div>
</div>
<div class="body">
  <div class="works">
    <div class="works-header section-header">
      <h2>Projects</h2>
      <div class="work-filter">
        <ul>
          <li class="title" type="html_css">html-css</li>
          <li class="title active" type="react">react</li>
          <li class="title" type="nodejs">node.js</li>
          <!-- <li class="title" type="logo">logo</li> -->
        </ul>
      </div>
      <div class="work-filter-shortcut">
        <i class='bx bx-dots-vertical-rounded'></i>
      </div>
    </div>
    <div class="works-content">
      <%- include('works-body') %>
    </div>
  </div>
  <div class="recommendations">
    <div class="recommendations-header section-header">
      <h2>Recommendations</h2>
      <p class="all-recommendations">see all</p>
    </div>
    <div class="recommendations-content">
      <div class="swiper mySwiper">
        <div class="swiper-wrapper">
          <% if (recommendationFavorite) { %>
          <% for (let i = 0; i < recommendationFavorite.length; i++) { %>
          <div class="swiper-slide recommendation-instance">
            <div class="recommendation-header">
              <div class="profile">
                <div class="profile-pic">
                  <img src="data:image/<%=recommendationFavorite[i].pic.extension%>;base64,<%=recommendationFavorite[i].pic.path%>" alt="Customer Pic">
                </div>
                <h3><%= recommendationFavorite[i].username %></h3>
              </div>
              <span>
                <% for (let j = 1; j <= 5; j++) { %>
                <% if (j <= recommendationFavorite[i].rate) { %>
                <i class='bx bxs-star'></i>
                <% } else { %>
                <i class='bx bx-star'></i>
                <% } %>
                <% } %>
              </span>
            </div>
            <div class="recommendation-content">
              <p><%= recommendationFavorite[i].message %></p>
            </div>
            <div class="recommendation-footer">
              <p><%= recommendationFavorite[i].date %></p>
            </div>
          </div>
          <% } %>
          <% } %>
        </div>
        <div class="swipe-btns">
          <div class="swiper-pagination"></div>
          <div>
            <div class="swiper-button-prev-unique"><i class='bx bx-chevron-left'></i></div>
            <div class="swiper-button-next-unique"><i class='bx bx-chevron-right'></i></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="contact dark">
    <h2>Contact me</h2>
    <form method="post" id="contact-form" enctype="multipart/form-data">
      <div class="form-container">
        <div class="input-box">
          <input type="text" name="customer-name" id="customer-name" placeholder="Name" required>
          <label class="input-icon-box" for="customer-name"><i class='bx bxs-user'></i></label>
        </div>
        <div class="input-box">
          <input type="email" name="to" id="customer-email" placeholder="Email" required>
          <label class="input-icon-box" for="customer-email"><i class='bx bx-at'></i></label>
        </div>
        <div class="input-box">
          <input type="text" name="subject" id="customer-name" placeholder="Name" required>
          <label class="input-icon-box" for="customer-name"><i class='bx bxs-user'></i></label>
        </div>
        <div class="input-box">
          <textarea name="text" id="customer-message" cols="30" rows="13" placeholder="Message"></textarea>
          <label class="input-icon-box" for="customer-message"><i class='bx bxs-envelope'></i></label>
        </div>
        <div class="submit-box">
          <input type="submit" id="submit-button" value="send message">
        </div>
      </div>
    </form>
  </div>
</div>
<div class="footer">
  <footer>
    <div class="copyright">
      <p>Copyright &COPY; All right reserved 2023</p>
    </div>
    <div class="author">
      <p>Website author: <a href="#">Omar Scheph</a></p>
    </div>
  </footer>
</div>